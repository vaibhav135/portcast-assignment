# Local development only. Copy to .env; never commit deployment credentials.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=portcast
DB_USERNAME=portcast
DB_PASSWORD=portcast_dev

# Host Python commands use the DB_* values above. Compose apps connect to
# postgres:5432 with fixed demo credentials and do not require this file.
# Optional Compose host-port overrides (useful for isolated runtime checks):
# POSTGRES_HOST_PORT=5433
# SERVER_HOST_PORT=8000
# CONSUMER_HOST_PORT=8001
